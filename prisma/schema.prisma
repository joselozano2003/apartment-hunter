generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Viewing {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  date       DateTime    @db.Date
  start_time String      @db.VarChar(8)
  end_time   String?     @db.VarChar(8)
  address    String
  notes        String?
  commute_mins Int?
  status       String      @default("upcoming")
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  apartments Apartment[]

  @@map("viewings")
}

model Apartment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewing_id   String    @db.Uuid
  unit_label   String
  monthly_rent Int?
  bedrooms     Int?
  bathrooms    Decimal?  @db.Decimal(3, 1)
  sqft         Int?
  rating               Int?
  notes                String?
  includes_water       Boolean?
  includes_electricity Boolean?
  includes_heating     Boolean?
  includes_gym         Boolean?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  viewing      Viewing   @relation(fields: [viewing_id], references: [id], onDelete: Cascade)
  photos       Photo[]

  @@map("apartments")
}

model Photo {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apartment_id String    @db.Uuid
  blob_url     String
  caption      String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  apartment    Apartment @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@map("photos")
}
